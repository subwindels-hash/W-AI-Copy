// ─────────────────────────── Session 15: Mobile ───────────────────────────
model MobileDevice {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform         String    // "ios" | "android" | "web-pwa" — stored as string to keep enums flexible
  deviceName       String?
  osVersion        String?
  appVersion       String?
  deviceModel      String?
  /// bcrypt hash of the device PIN fallback.
  ///
  /// Must stay a dedicated column: this previously shared `deviceModel`, which
  /// POST /mobile/devices/register writes straight from the request body
  /// (`deviceModel: z.string().max(64)`). A bcrypt hash is 60 characters, so a
  /// caller could overwrite the stored hash — or plant the hash of a PIN they
  /// chose — and then satisfy the PIN check. Never expose this field in a
  /// select or accept it from a request body.
  pinHash          String?
  pushTokenHash    String?   // sha256 of the push endpoint for quick lookups/rotations
  biometricEnabled Boolean   @default(false)
  lastSeenAt       DateTime  @default(now())
  lastIp           String?
  lastUserAgent    String?
  createdAt        DateTime  @default(now())

  subscriptions    PushSubscription[]
  biometricCredentials BiometricCredential[]

  @@index([userId])
  @@index([lastSeenAt])
}

model PushSubscription {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String
  device         MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  endpoint       String       @unique
  p256dh         String       // base64 client public key
  auth           String       // base64 auth secret
  vapidPublicKey String
  userAgent      String?
  failures       Int          @default(0)
  lastDeliveredAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
}

model BiometricCredential {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  device      MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  credentialId String      // base64url WebAuthn credential id
  publicKey   String       // base64url COSE public key
  counter     Int          @default(0)
  transports  String?      // comma-separated
  aaguid      String?
  createdAt   DateTime     @default(now())
  lastUsedAt  DateTime?

  @@index([userId])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  type           String   // message | meeting | task | alert | mention | system
  title          String
  body           String
  icon           String?
  url            String?  // deep link
  data           Json     @default("{}")
  pushDelivered  Boolean  @default(false)
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([readAt])
}

