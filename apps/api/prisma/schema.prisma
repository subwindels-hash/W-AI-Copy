model Workflow {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String?
  workspace      Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  status         WorkflowStatus @default(DRAFT)
  // node graph JSON
  nodes          Json           @default("[]")
  edges          Json           @default("[]")
  // settings: retryCount, retryDelayMs, trigger config, agentId, etc.
  settings       Json           @default("{}")
  triggers       Json           @default("[]") // [{type:"manual"|"schedule"|"event"|"webhook", config:{...}}]
  createdById    String
  createdBy      User           @relation("workflows_created", fields: [createdById], references: [id])
  lastRunAt      DateTime?
