{
  "name": "windels-ai-os",
  "version": "0.1.0",
  "private": true,
  "description": "WINDELS AI OS — AI-Native Enterprise Operating System",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "prebuild": "node scripts/prisma-preflight.mjs",
    "pretest": "node scripts/prisma-preflight.mjs",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @windels/api exec prisma generate",
    "db:generate:offline": "bash scripts/prisma-generate-offline.sh",
    "orphans": "node scripts/find-orphans.mjs",
    "orphans:write": "node scripts/find-orphans.mjs --write",
    "db:migrate": "pnpm --filter @windels/api exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @windels/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @windels/api exec tsx prisma/seed.ts",
    "api": "pnpm --filter @windels/api dev",
    "web": "pnpm --filter @windels/web dev",
    "docker:build": "docker build -f infra/docker/Dockerfile.api -t windels-ai-api:dev . && docker build -f infra/docker/Dockerfile.web -t windels-ai-web:dev .",
    "docker:up": "docker compose -f docker-compose.yml -f infra/docker/docker-compose.prod.yml up -d",
    "docker:dev": "docker compose up -d postgres redis",
    "monitoring:up": "docker compose -f infra/monitoring/docker-compose.monitoring.yml up -d",
    "k8s:deploy": "kubectl apply -k infra/k8s",
    "k8s:delete": "kubectl delete -k infra/k8s",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:load": "k6 run tests/load/health-get.js",
    "test:load:chat": "k6 run tests/load/chat-streams.js"
  },
  "devDependencies": {
    "@playwright/test": "~1.48.2",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.34.5"
}
