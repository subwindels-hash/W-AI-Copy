# ============================================================================
# WINDELS AI OS — environment configuration
# ============================================================================
# Copy this file to `.env` in the same directory as index.php
# (cPanel → File Manager → + File → name it `.env` → Edit).
#
# These are the ONLY values that change between servers. Everything else about
# the application is portable: upload the files, import database/production.sql
# through phpMyAdmin, fill in this file, and open the site. No Terminal, SSH,
# Composer, Node.js, Docker or migration command is involved.
#
# KEEP VP_ENCRYPTION_KEY AND VP_AUTH_SECRET IDENTICAL WHEN MOVING HOSTS.
# They protect stored credentials and sign access tokens; copying the existing
# values keeps passwords, refresh tokens and encrypted data working after the
# move.
# ============================================================================

# ---------------------------------------------------------------------------
# Required — every deployment must set these
# ---------------------------------------------------------------------------

# production | development. Use `production` (it hides errors from visitors).
CI_ENV=production

# Full public URL of the site, no trailing slash. Used for links, cookies and
# upload URLs.
VP_BASE_URL=https://yourdomain.com

# Database credentials as shown by cPanel → MySQL Databases. cPanel prefixes
# both the database name and the user name with the account name.
VP_DB_HOST=localhost
VP_DB_PORT=3306
VP_DB_NAME=cpaneluser_windels
VP_DB_USER=cpaneluser_windels
VP_DB_PASS=change-me

# 32+ characters. Encrypts stored secrets (MFA, SSO, integrations, mailbox
# passwords, issued PINs). NEVER change it on a live database without a
# re-key: existing encrypted values become unreadable. Copy it when migrating.
VP_ENCRYPTION_KEY=keep-the-same-key-when-moving-hosts

# 32+ characters. Signs access and refresh tokens. Copy it when migrating so
# outstanding tokens stay valid.
VP_AUTH_SECRET=replace-with-a-long-random-secret-and-keep-it

# Private key (16+ characters) for the one-off browser admin page at
# https://yourdomain.com/setup?key=THIS_VALUE. Only needed for a brand new
# database that has no users yet (skip it if you import
# database/seed-admin.sql instead). Delete or replace the value afterwards.
VP_SETUP_KEY=replace-with-a-private-one-time-browser-setup-key

# ---------------------------------------------------------------------------
# Optional — sensible defaults, change when the feature is used
# ---------------------------------------------------------------------------

# PHP session cookie name (only used if you enable the session library).
VP_SESSION_NAME=windels_session

# Maximum upload size in kilobytes.
VP_UPLOAD_MAX_KB=10240

# Signing secret for outbound webhook payloads.
VP_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Outbound mail (password resets, notifications). Leave VP_MAIL_HOST empty to
# disable delivery; the application keeps working and simply logs instead.
VP_MAIL_HOST=
VP_MAIL_PORT=587
VP_MAIL_USER=
VP_MAIL_PASS=
VP_MAIL_CRYPTO=tls
VP_MAIL_FROM=no-reply@yourdomain.com

# AI provider credentials. With no key the application falls back to its
# built-in echo provider, so the site runs without one.
VP_OPENAI_API_KEY=
VP_OPENAI_BASE_URL=https://api.openai.com/v1
VP_OPENAI_MODEL=gpt-4o-mini

# CDN control plane (GET/PUT/POST /api/v1/platform/cdn/*). Leave both empty for
# the normal single-server install: edge metrics stay blank rather than showing
# invented numbers, and a purge is recorded as "skipped" with a reason instead
# of pretending to have cleared a cache.
VP_CDN_ENABLED=false
VP_CDN_PROVIDER=

# Value of the Access-Control-Allow-Origin header. Set it to the exact site
# origin (for example https://yourdomain.com) instead of * in production.
CORS_ORIGIN=*

# Issuer claim (`iss`) embedded in issued JSON Web Tokens.
JWT_ISSUER=windels-php

# ---------------------------------------------------------------------------
# Optional — response security headers
# ---------------------------------------------------------------------------
# X-Content-Type-Options: nosniff and Referrer-Policy are always sent, and
# Strict-Transport-Security is sent on HTTPS. The two below are opt-in because a
# wrong default breaks real pages — see php/CPANEL_DEPLOYMENT.md.

# Full Content-Security-Policy string, sent only when set. The bundled SPA has
# an inline boot script and inline styles, so a strict script-src 'self' blanks
# the splash screen until you add the directives your bundle needs.
VP_SECURITY_CSP=

# Frame policy: 'none' (X-Frame-Options: DENY), 'self' (SAMEORIGIN), or an
# explicit source list for frame-ancestors. Leave empty while the app is
# embedded in dashboards or preview panels.
VP_SECURITY_FRAME_ANCESTORS=

# HSTS max-age in seconds. Default 15552000 (180 days). Set 0 to omit HSTS.
VP_SECURITY_HSTS_MAX_AGE=15552000

# Overrides the default Referrer-Policy.
VP_SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
