{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "API QPS",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(http_requests_total[1m])", "legendFormat": "{{method}} {{route}}" }]
    },
    {
      "title": "p95 Latency by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, route))", "legendFormat": "{{route}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))/sum(rate(http_requests_total[1m]))", "legendFormat": "5xx ratio" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "title": "Node RSS / Heap",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "nodejs_rss_bytes", "legendFormat": "RSS" },
        { "expr": "nodejs_heap_used_bytes", "legendFormat": "Heap used" },
        { "expr": "nodejs_heap_total_bytes", "legendFormat": "Heap total" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "Active handles/requests",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "targets": [
        { "expr": "nodejs_active_handles", "legendFormat": "handles" },
        { "expr": "nodejs_active_requests", "legendFormat": "requests" }
      ]
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "targets": [{ "expr": "nodejs_uptime_seconds", "legendFormat": "uptime" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Load average",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "system_loadavg_1m", "legendFormat": "1m" },
        { "expr": "system_loadavg_5m", "legendFormat": "5m" },
        { "expr": "system_loadavg_15m", "legendFormat": "15m" }
      ]
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["windels"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
