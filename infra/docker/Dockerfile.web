# syntax=docker/dockerfile:1.7
# ────────────────────────────────────────────────────────────────────────────
# WINDELS AI OS — Web image (static files served by nginx:alpine)
# Reverse-proxies /api/* to the API service, gzip, security headers, SPA fallback.
# ────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
ENV PNPM_HOME="/pnpm" PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.34.5 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,id=pnpm-web,target=/pnpm/store \
    pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @windels/web build

FROM nginx:1.27-alpine AS runner
ENV API_UPSTREAM=http://api:4000
COPY infra/docker/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost/ >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
