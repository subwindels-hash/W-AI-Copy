# syntax=docker/dockerfile:1.7
# ────────────────────────────────────────────────────────────────────────────
# WINDELS AI OS — API image (Node 20 Alpine, non-root, production-only deps)
# ────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm" \
    PATH="$PNPM_HOME:$PATH" \
    NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@10 --activate
WORKDIR /app
RUN addgroup -g 1001 -S nodejs && adduser -S windels -u 1001 -G nodejs

# ── deps (production only) ──────────────────────────────────────────────────
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --prod --frozen-lockfile=false --no-optional

# ── build ───────────────────────────────────────────────────────────────────
FROM base AS build
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile=false
COPY . .
RUN pnpm --filter @windels/shared build 2>/dev/null || true
RUN pnpm --filter @windels/api build

# ── generate Prisma client in production deps ───────────────────────────────
FROM deps AS prisma
COPY apps/api/prisma ./apps/api/prisma
COPY apps/api/package.json ./apps/api/package.json
RUN cd apps/api && pnpm exec prisma generate

# ── runner ──────────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
ENV NODE_ENV=production \
    PNPM_HOME="/pnpm" \
    PATH="$PNPM_HOME:$PATH" \
    API_PORT=4000 \
    API_HOST=0.0.0.0
RUN corepack enable && corepack prepare pnpm@10 --activate \
    && apk add --no-cache tini curl \
    && addgroup -g 1001 -S nodejs && adduser -S windels -u 1001 -G nodejs
WORKDIR /app
USER windels
COPY --from=prisma --chown=windels:nodejs /app/node_modules ./node_modules
COPY --from=prisma --chown=windels:nodejs /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=prisma --chown=windels:nodejs /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=build --chown=windels:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=windels:nodejs /app/apps/api/prisma ./apps/api/prisma
COPY --from=build --chown=windels:nodejs /app/packages/shared/dist ./packages/shared/dist 2>/dev/null || true
COPY --from=build --chown=windels:nodejs /app/package.json ./package.json
COPY --from=build --chown=windels:nodejs /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build --chown=windels:nodejs /app/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=windels:nodejs /app/packages/shared/package.json ./packages/shared/package.json

EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS http://localhost:4000/api/v1/health || exit 1
WORKDIR /app/apps/api
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/index.js"]
