{
  "schemaVersion": 1,
  "id": "com.example.research",
  "name": "Example Research Module",
  "version": "1.0.0",
  "platform": "windels-ai-os",
  "packageType": "module",
  "description": "An example externally isolated research capability for WINDELS AI OS.",
  "author": "Example Engineering",
  "vendor": "Example Vendor Ltd",
  "license": "Proprietary",
  "minimumVersion": "0.1.0",
  "apiVersion": "v1",
  "dependencies": [
    {
      "id": "com.example.knowledge-base",
      "version": ">=1.0.0 <2.0.0",
      "optional": true
    }
  ],
  "permissions": ["ORG_READ", "AGENT_READ", "WORKFLOW_READ"],
  "accessRoles": ["admin", "super_admin"],
  "capabilities": ["research.query", "research.summarize"],
  "backend": {
    "enabled": true,
    "mode": "external_service",
    "routes": [
      {
        "method": "POST",
        "path": "/query",
        "permission": "ORG_READ",
        "description": "Run an authorized research query."
      },
      {
        "method": "GET",
        "path": "/reports/:id",
        "permission": "ORG_READ",
        "description": "Read one generated report."
      }
    ],
    "healthPath": "/health",
    "webhooks": [],
    "backgroundJobs": ["research-index-refresh"],
    "eventHandlers": ["knowledge.updated"]
  },
  "frontend": {
    "enabled": true,
    "mode": "declarative",
    "navigation": [
      {
        "label": "Research Module",
        "path": "/",
        "icon": "Puzzle",
        "order": 500
      }
    ],
    "pages": [
      {
        "path": "/",
        "title": "Research Module",
        "description": "External research capability hosted through the WINDELS module runtime.",
        "sections": [
          {
            "type": "info",
            "title": "Runtime isolation",
            "body": "This module runs outside the core WINDELS process and uses existing IAM, audit, workflow, agent and knowledge services."
          },
          {
            "type": "links",
            "title": "Documentation",
            "links": [
              {
                "label": "Vendor security documentation",
                "href": "https://example.com/security"
              }
            ]
          }
        ]
      }
    ]
  },
  "database": {
    "migrations": ["database/migrations/001_create_research_schema.sql"],
    "mode": "isolated_schema",
    "rollbackFiles": ["database/rollback/001_drop_research_schema.sql"],
    "backupRequired": true
  },
  "agents": {
    "definitions": ["agents/research-assistant.json"]
  },
  "workflows": {
    "definitions": ["workflows/research-review.json"]
  },
  "configuration": {
    "schema": "config/schema.json",
    "documentation": "docs/configuration.md"
  },
  "documentation": ["docs/README.md", "docs/security.md", "docs/operations.md"],
  "tests": {
    "command": "npm test",
    "categories": ["unit", "integration", "api", "database", "permission", "security", "health", "frontend", "workflow", "agent"]
  },
  "healthChecks": [
    {
      "name": "HTTP readiness",
      "type": "http",
      "path": "/health",
      "timeoutMs": 5000
    },
    {
      "name": "Runner integration checks",
      "type": "runner",
      "timeoutMs": 30000
    }
  ],
  "resources": {
    "memoryMb": 512,
    "cpuMillicores": 500,
    "storageMb": 2048,
    "networkAccess": false
  },
  "lifecycle": {
    "reloadSupported": true,
    "removable": true
  },
  "upgrade": {
    "from": [">=0.9.0 <2.0.0"],
    "rollbackSupported": true,
    "allowDowngrade": false,
    "requiresDowntime": false,
    "instructions": "docs/upgrade.md"
  },
  "conflicts": {
    "moduleIds": [],
    "capabilities": []
  }
}
