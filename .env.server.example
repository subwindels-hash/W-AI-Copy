# WINDELS AI OS — single-server production environment
# Copy to .env.server, fill every REQUIRED value, and never commit that file.
# Generate URL-safe database/cache/JWT secrets with: openssl rand -hex 32
# Generate the encryption key with:                  openssl rand -hex 32
# Generate VAPID keys with:                          npx web-push generate-vapid-keys

# ── Public endpoint (DNS A/AAAA record must point to this server) ───────────
DOMAIN=
ACME_EMAIL=

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=windels_owner
POSTGRES_DB=windels
# REQUIRED. Keep these URL-safe because they are embedded in connection URLs.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=

# ── Redis ───────────────────────────────────────────────────────────────────
# REQUIRED. Keep URL-safe because it is embedded in REDIS_URL.
REDIS_PASSWORD=

# ── Authentication and encryption ──────────────────────────────────────────
# REQUIRED: at least 32 random bytes (64 hex characters recommended).
JWT_SECRET=
# REQUIRED: independent secret used for inbound webhook HMAC verification.
WEBHOOK_SECRET=
# REQUIRED: exactly 64 hexadecimal characters (AES-256-GCM master key).
WINDELS_ENCRYPTION_KEY=
WINDELS_ENCRYPTION_KEY_ID=k1
# Keep previous id->64-hex keys here only during controlled master-key rotation.
#WINDELS_ENCRYPTION_KEYRING={}
JWT_ISSUER=windels-ai-os
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_COOKIE_NAME=windels_sid

# ── Initial administrator ───────────────────────────────────────────────────
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
# REQUIRED: use a unique password of 16+ characters.
BOOTSTRAP_SUPERADMIN_PASSWORD=

# ── Web Push (generate a unique pair for this deployment) ──────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Runtime behavior ────────────────────────────────────────────────────────
LOG_LEVEL=info
WINDELS_DEMO_DATA=false
WINDELS_ALLOW_MOCK_DB_FALLBACK=false
WINDELS_CONSTITUTION_FAIL_OPEN=false
IMAGE_TAG=local
GIT_COMMIT=

# ── AI provider (optional, but AI calls fail closed without a real provider) ─
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Uncomment both only when a reachable Ollama server exists. Setting a model
# by itself makes the registry attempt the localhost default.
# OLLAMA_BASE_URL=https://ollama.example.com
# OLLAMA_MODEL=llama3
AI_REQUIRE_REAL_MODEL=true
AI_DEFAULT_MODEL=windels-assistant

# Public /v1 remains disabled until provider, billing, quota, and isolation
# acceptance tests have passed for this deployment.
WINDELS_NATIVE_API_ENABLED=false
# Compose sets WINDELS_PUBLIC_API_ORIGIN from DOMAIN.
WINDELS_NATIVE_CHAT_MODEL=
WINDELS_NATIVE_EMBEDDING_MODEL=

# ── Payments (optional; uncomment a complete provider set only) ────────────
# Payment adapters fail closed when credentials are absent or incomplete.
#PAYSTACK_SECRET_KEY=
#FLUTTERWAVE_SECRET_KEY=
#FLUTTERWAVE_SECRET_HASH=
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
#PAYPAL_ENVIRONMENT=sandbox
#PAYPAL_CLIENT_ID=
#PAYPAL_CLIENT_SECRET=
#PAYPAL_WEBHOOK_ID=
# Blockonomics remains disabled until its implementation/validation stages pass.
#BLOCKONOMICS_ENABLED=false
#BLOCKONOMICS_API_KEY=
#BLOCKONOMICS_CALLBACK_SECRET=
#BLOCKONOMICS_MATCH_CALLBACK=payments.example.com
#BLOCKONOMICS_SUPPORTED_ASSETS=BTC,USDT
#BLOCKONOMICS_QUOTE_EXPIRY_MINUTES=15
#BLOCKONOMICS_TEST_MODE=true

# ── Optional error reporting / integrations ────────────────────────────────
SENTRY_DSN=
WHATSAPP_ENABLED=false
CLOUD_ANDROID_ENABLED=false
WINDELS_MT5_GLOBAL_READONLY=true
WINDELS_MT4_GLOBAL_READONLY=true
WINDELS_CRYPTO_GLOBAL_READONLY=true
